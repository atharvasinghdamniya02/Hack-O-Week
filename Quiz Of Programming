<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>C Quiz Pro</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Orbitron', sans-serif;
}

body{
background:#0a0a0a;
color:white;
overflow-x:hidden;
}

/* 🌌 Background animation */
body::before{
content:"";
position:fixed;
width:200%;
height:200%;
background:linear-gradient(60deg,#00f0ff,#ff00c8,#00ff88,#00f0ff);
background-size:400%;
animation:wave 12s linear infinite;
opacity:0.15;
z-index:-1;
}

@keyframes wave{
0%{transform:translate(-25%,-25%) rotate(0deg);}
100%{transform:translate(-25%,-25%) rotate(360deg);}
}

/* 🌟 Container */
.quiz-container{
width:90%;
max-width:800px;
margin:50px auto;
padding:30px;
border-radius:15px;
background:rgba(255,255,255,0.05);
backdrop-filter:blur(20px);
box-shadow:0 0 40px rgba(0,255,255,0.2);
}

/* 🔥 Heading */
h1{
text-align:center;
margin-bottom:20px;
background:linear-gradient(90deg,#00f0ff,#ff00c8,#00ff88);
-webkit-background-clip:text;
color:transparent;
animation:shine 4s linear infinite;
}

@keyframes shine{
0%{background-position:0%;}
100%{background-position:200%;}
}

/* 📊 Progress bar */
.progress-bar{
height:6px;
background:#222;
border-radius:10px;
margin-bottom:20px;
overflow:hidden;
}

.progress{
height:100%;
width:0%;
background:#00f0ff;
transition:0.3s;
}

/* 💡 Question */
.question{
margin-bottom:20px;
padding:15px;
border-radius:10px;
background:rgba(255,255,255,0.05);
transition:0.3s;
}

.question:hover{
box-shadow:0 0 15px rgba(0,255,255,0.4);
}

/* 🎯 Options */
.options label{
display:block;
padding:8px;
margin:5px 0;
cursor:pointer;
border-radius:6px;
transition:0.3s;
}

.options label:hover{
background:rgba(0,255,255,0.2);
transform:translateX(5px);
}

/* 🚀 Button */
button{
width:100%;
padding:14px;
font-size:16px;
border:none;
border-radius:8px;
background:linear-gradient(90deg,#00f0ff,#ff00c8);
color:white;
cursor:pointer;
transition:0.3s;
}

button:hover{
transform:scale(1.05);
box-shadow:0 0 20px #00f0ff;
}

/* 🧠 Result */
.result{
text-align:center;
font-size:22px;
margin-top:20px;
}

</style>
</head>

<body>

<div class="quiz-container">

<h1>⚡ C PROGRAMMING QUIZ ⚡</h1>

<div class="progress-bar">
<div class="progress" id="progress"></div>
</div>

<form id="quizForm">

<!-- QUESTIONS -->

<div class="question">
<p>1. Who developed C language?</p>
<div class="options">
<label><input type="radio" name="q1" value="a"> Dennis Ritchie</label>
<label><input type="radio" name="q1" value="b"> James Gosling</label>
<label><input type="radio" name="q1" value="c"> Bjarne Stroustrup</label>
<label><input type="radio" name="q1" value="d"> Guido van Rossum</label>
</div>
</div>

<div class="question">
<p>2. Single line comment?</p>
<div class="options">
<label><input type="radio" name="q2" value="a"> //</label>
<label><input type="radio" name="q2" value="b"> ##</label>
<label><input type="radio" name="q2" value="c"> **</label>
<label><input type="radio" name="q2" value="d"> %%</label>
</div>
</div>

<div class="question">
<p>3. File extension?</p>
<div class="options">
<label><input type="radio" name="q3" value="a"> .java</label>
<label><input type="radio" name="q3" value="b"> .py</label>
<label><input type="radio" name="q3" value="c"> .c</label>
<label><input type="radio" name="q3" value="d"> .cpp</label>
</div>
</div>

<div class="question">
<p>4. Output function?</p>
<div class="options">
<label><input type="radio" name="q4" value="a"> cout</label>
<label><input type="radio" name="q4" value="b"> printf()</label>
<label><input type="radio" name="q4" value="c"> print()</label>
<label><input type="radio" name="q4" value="d"> echo()</label>
</div>
</div>

<div class="question">
<p>5. Header for printf?</p>
<div class="options">
<label><input type="radio" name="q5" value="a"> stdio.h</label>
<label><input type="radio" name="q5" value="b"> math.h</label>
<label><input type="radio" name="q5" value="c"> string.h</label>
<label><input type="radio" name="q5" value="d"> conio.h</label>
</div>
</div>

<div class="question">
<p>6. Size of int?</p>
<div class="options">
<label><input type="radio" name="q6" value="a"> 2</label>
<label><input type="radio" name="q6" value="b"> 4</label>
<label><input type="radio" name="q6" value="c"> 8</label>
<label><input type="radio" name="q6" value="d"> 16</label>
</div>
</div>

<div class="question">
<p>7. Loop runs at least once?</p>
<div class="options">
<label><input type="radio" name="q7" value="a"> for</label>
<label><input type="radio" name="q7" value="b"> while</label>
<label><input type="radio" name="q7" value="c"> do while</label>
<label><input type="radio" name="q7" value="d"> none</label>
</div>
</div>

<div class="question">
<p>8. Address operator?</p>
<div class="options">
<label><input type="radio" name="q8" value="a"> *</label>
<label><input type="radio" name="q8" value="b"> &</label>
<label><input type="radio" name="q8" value="c"> %</label>
<label><input type="radio" name="q8" value="d"> #</label>
</div>
</div>

<div class="question">
<p>9. Return keyword?</p>
<div class="options">
<label><input type="radio" name="q9" value="a"> stop</label>
<label><input type="radio" name="q9" value="b"> break</label>
<label><input type="radio" name="q9" value="c"> return</label>
<label><input type="radio" name="q9" value="d"> exit</label>
</div>
</div>

<div class="question">
<p>10. Best loop when known?</p>
<div class="options">
<label><input type="radio" name="q10" value="a"> for</label>
<label><input type="radio" name="q10" value="b"> while</label>
<label><input type="radio" name="q10" value="c"> do while</label>
<label><input type="radio" name="q10" value="d"> goto</label>
</div>
</div>

<button type="button" onclick="checkQuiz()">Submit Quiz</button>

</form>

<div class="result" id="result"></div>

</div>

<script>

const total = 10;

/* 📊 Update progress */
document.querySelectorAll("input").forEach(input=>{
input.addEventListener("change",()=>{
let answered = document.querySelectorAll("input:checked").length;
document.getElementById("progress").style.width = (answered/total)*100 + "%";
});
});

function checkQuiz(){
let score=0;

let answers={
q1:"a",q2:"a",q3:"c",q4:"b",q5:"a",
q6:"b",q7:"c",q8:"b",q9:"c",q10:"a"
};

for(let q in answers){
let selected=document.querySelector('input[name="'+q+'"]:checked');
if(selected && selected.value===answers[q]) score++;
}

document.getElementById("result").innerHTML="🔥 Score: "+score+"/10";
}

</script>

</body>
</html>
